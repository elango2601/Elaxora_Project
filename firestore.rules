rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is the Admin safely
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && 
             request.auth.token.email != null && 
             (
               request.auth.token.email == "elaxora11@gmail.com" || 
               request.auth.token.email == "Elaxora11@gmail.com" || 
               request.auth.token.email == "elango2601@gmail.com" ||
               request.auth.token.email == "elangopugal26@gmail.com"
             );
    }

    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /referrals/{document=**} {
      allow read, update: if true;
      allow write: if isAdmin();
    }
    
    match /enquiries/{document=**} {
      allow create: if true; // Anyone can submit an enquiry
      allow read, update, delete: if isAdmin() || (request.auth != null && request.auth.token != null && request.auth.token.email == resource.data.email);
    }

    match /quotes/{document=**} {
      allow read, update: if true;
      allow create, delete: if isAdmin();
    }

    match /orders/{document=**} {
      // Students can read their own orders, Admin can do everything
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{document=**} {
      // Users can read/write their own profile, Admin can do everything
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == document);
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
